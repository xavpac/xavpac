# Copier ce fichier vers .env.local lorsque les vraies API seront connectées.

NEXT_PUBLIC_APP_NAME=XavPac
# Exemples futurs :
# OPENSKY_USERNAME=
# OPENSKY_PASSWORD=
# WEATHER_API_KEY=
# NOTAM_API_KEY=

# Optionnel et gratuit : compte OpenSky sans carte bancaire.
# Sans ces variables, XavPac reste pleinement fonctionnel avec ADSBDB.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Tous les fournisseurs sont indépendants et désactivables sans modifier le code.
AIRPLANES_LIVE_ENABLED=true
ADSBDB_ENABLED=true
PLANESPOTTERS_ENABLED=true
XAVPAC_CONTACT_URL=https://github.com/xavpac/xavpac
OPENSKY_ENABLED=true
CELESTRAK_ENABLED=true

# Foudre structurée : nécessite un contrat ou une source explicitement autorisée.
# Sans ces variables, XavPac affiche la carte publique indicative mais aucune statistique.
LIGHTNING_PROVIDER_URL=
LIGHTNING_PROVIDER_TOKEN=
LIGHTNING_PROVIDER_NAME=

# Détections thermiques officielles NASA FIRMS.
# Créer gratuitement une MAP_KEY sur https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=
NASA_FIRMS_SOURCE=VIIRS_SNPP_NRT
